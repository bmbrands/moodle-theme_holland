{{!
    @template theme_holland/footer

    Holland theme custom footer.

    Example context (json):
    {
        "output": {
            "page_doc_link": "Documentation for this page",
            "supportemail": "<a href=\"#\">Contact site support</a>",
            "login_info": "You are logged in as cute kitten",
            "moodle_release": "90210"
        }
    }
}}

<footer id="page-footer" class="holland-footer">
    <div class="holland-footer-inner">
        <div class="holland-footer-grid">
            <div class="holland-footer-brand">
                <span class="holland-footer-logo gradient-text">Reasonsto</span>
                <p class="holland-footer-tagline">{{#str}}poweredbymoodle, core{{/str}}</p>
                {{#output.moodle_release}}
                <p class="holland-footer-version">{{#str}}version, core{{/str}} {{{ output.moodle_release }}}</p>
                {{/output.moodle_release}}
            </div>

            <div class="holland-footer-links">
                {{# output.page_doc_link }}
                    <div class="holland-footer-link">{{{ output.page_doc_link }}}</div>
                {{/ output.page_doc_link }}
                {{# output.supportemail }}
                    <div class="holland-footer-link">{{{ output.supportemail }}}</div>
                {{/ output.supportemail }}
            </div>

            <div class="holland-footer-meta">
                <div class="holland-footer-logininfo">{{{ output.login_info }}}</div>
                <div class="tool_usertours-resettourcontainer"></div>
                {{{ output.standard_footer_html }}}
            </div>
        </div>

        <div class="holland-footer-bottom">
            <p class="holland-footer-copy">&copy; {{#str}}pluginname, theme_holland{{/str}}</p>
        </div>
    </div>

    {{{ output.standard_end_of_body_html }}}

    <div class="holland-footer-debug">
        {{{ output.debug_footer_html }}}
    </div>
</footer>
