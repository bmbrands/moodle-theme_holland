{{!
    @template theme_holland/theme/adminbar

    This template renders action menu for each course.

    Example context (json):
    {
        "hasadminbar": true,
        "isadminsearch": false,
        "secondarymoremenu": true,
        "output": {
            "edit_switch": "edit",
            "admin_link": "<a href='#'>Site administration</a>"
        }
    }
}}
{{#holland.hasadminbar}}
    <nav id="mainadminbar" class="adminbar collapse show">
        <div class="adminbar-inner border-0 d-flex">
            {{^isadminsearch}}
                {{#secondarymoremenu}}
                    <div class="secondary-navigation d-print-none">
                        {{> core/moremenu}}
                    </div>
                {{/secondarymoremenu}}
            {{/isadminsearch}}
            {{#isadminsearch}}
                {{#primarymoremenu}}
                    <div class="primary-navigation">
                        {{> core/moremenu}}
                    </div>
                {{/primarymoremenu}}
            {{/isadminsearch}}
            <div class="ms-md-auto">
                {{{output.edit_switch}}}
            </div>
            <ul role="menubar" class="nav moremenu observed">
                <li class="nav-item">
                    {{{output.admin_link}}}
                </li>
            </ul>
        </div>
    </nav>
    <div class="adminbar-toggler d-none">
        <button class="btn btn-round" data-toggle="collapse" data-target="#mainadminbar" aria-expanded="true" aria-controls="mainadminbar">
            <i class="fa fa-bars" aria-hidden="true"></i>
        </button>
    </div>
{{/holland.hasadminbar}}
