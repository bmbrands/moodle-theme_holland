{{!
    @template theme_holland/theme/usermenu

    This template renders action menu for each course.

    Example context (json):
    {
        "progress": "20"
    }
}}
<div class="nav user-dropdown">
    <div class="nav-item dropdown">
        {{#unauthenticateduser}}
            <a class="btn btn-primary" href="{{{loginurl}}}">{{#str}}login{{/str}}</a>
        {{/unauthenticateduser}}
        {{^unauthenticateduser}}
        <a class="nav-link dropdown-toggle d-flex" data-bs-toggle="dropdown" href="#" role="button" aria-expanded="false">
            {{#metadata.asotheruser}}
            <div class="loggedinas">
                <div class="realuser">
                    <span class="sr-only">{{{metadata.realuserfullname}}}</span>
                    <div class="avatar">
                        {{{metadata.realuseravatar}}}
                    </div>
                </div>
                <div class="currentuser">
                    <span class="sr-only">{{{metadata.userfullname}}}</span>
                    <div class="avatar">
                        {{{metadata.useravatar}}}
                    </div>
                </div>
            </div>
            {{/metadata.asotheruser}}
            {{#metadata.asotherrole}}
            {{/metadata.asotherrole}}
            {{^metadata.asotheruser}}
                <div class="user">
                    <span class="sr-only">{{{metadata.userfullname}}}</span>
                    <div class="avatar">
                        {{{metadata.useravatar}}}
                    </div>
                </div>
            {{/metadata.asotheruser}}
        </a>
        <div class="dropdown-menu dropdown-menu-right rounded-1 shadow-sm">
            <div class="dropdown-item border-bottom border-light pb-2 mb-2">
                <div class="d-flex align-items-center">
                    <div class="user">
                        <a href="{{{metadata.userprofileurl}}}" class="profilelink text-primary">{{{metadata.userfullname}}}</a>
                        <div class="email small muted">{{{user.email}}}</div>
                    </div>
                </div>
            </div>
            {{#navitems}}
                {{#url}}
                <a class="dropdown-item py-2 d-flex align-items-center" href="{{{url}}}">
                    {{{title}}}
                    {{#badge}}
                        <span class="badge bg-primary ms-auto">{{{badge}}}</span>
                    {{/badge}}
                </a>
                {{/url}}
                {{^url}}
                <div class="dropdown-divider"></div>
                {{/url}}
            {{/navitems}}
        </div>
        {{/unauthenticateduser}}
    </div>
</div>
