{{!
    @template theme_holland/theme/coursecard

    A single course card used across frontpage featured courses,
    available courses listing, and the my-overview card deck.

    Context variables required for this template:
    * viewurl - URL to the course
    * courseimage - URL to the course image
    * fullname - Full course name (used as title)
    * summary - Course summary / description (HTML)
    * coursecategory - Category name (optional)

    Example context (json):
    {
        "viewurl": "https://example.com/course/view.php?id=5",
        "courseimage": "https://example.com/course1.jpg",
        "fullname": "Introduction to Moodle",
        "summary": "Learn the basics of Moodle.",
        "coursecategory": "Miscellaneous"
    }
}}
<div>
    <div class="card ctrl-card dashboard-card h-100">
        <a href="{{{viewurl}}}" tabindex="-1">
            <div class="dashboard-card-img" style="background-image: url('{{{courseimage}}}'); height: 15rem;">
                <span class="sr-only">{{{fullname}}}</span>
            </div>
        </a>
        <div class="card-body">
            <h5 class="card-title">
                <a href="{{{viewurl}}}" class="aalink coursename">{{{fullname}}}</a>
            </h5>
            {{#coursecategory}}
            <p class="text-muted small mb-1">{{{coursecategory}}}</p>
            {{/coursecategory}}
            {{#summary}}
            <p class="card-text">{{#shortentext}}250, {{{summary}}} {{/shortentext}}</p>
            {{/summary}}
        </div>
        <div class="card-footer roundedbottom">
            <a href="{{{viewurl}}}" class="btn btn-yellow stretched-link">{{#str}}view{{/str}}</a>
        </div>
    </div>
</div>
