{{!
    @template theme_holland/theme/homebanner

    Hero banner for the Holland theme frontpage.

    Example context (json):
    {
    }
}}
<section id="homebanner" class="homebanner">
    <div class="bg-decorations">
        <div class="bg-blob bg-blob-primary"></div>
        <div class="bg-blob bg-blob-accent"></div>
        <div class="bg-blob bg-blob-center"></div>
    </div>

    {{^loggedin}}
    <div class="homebanner-login">
        <a href="{{{loginurl}}}" class="btn btn-gradient homebanner-login-btn">
            <i class="fa fa-sign-in me-2"></i>{{#str}}login, core{{/str}}
        </a>
    </div>
    {{/loggedin}}

    <div class="homebanner-inner">
        <div class="homebanner-grid">
            <div class="homebanner-content">
                <div class="homebanner-badge">
                    <span class="homebanner-badge-dot"></span>
                    {{#str}}homebanner_title, theme_holland{{/str}}

                </div>

                <h1 class="homebanner-title">
                    {{#str}}homebanner_badge, theme_holland{{/str}}
                </h1>

                <h2 class="homebanner-subtitle">
                    {{#str}}homebanner_subtitle, theme_holland{{/str}}
                </h2>

                <p class="homebanner-description">
                    {{#str}}homebanner_description, theme_holland{{/str}}
                </p>

                <div class="homebanner-actions">
                    <a href="/course/index.php" class="btn btn-gradient homebanner-btn-primary">
                        {{#str}}homebanner_viewplugins, theme_holland{{/str}}
                        <i class="fa fa-arrow-right ms-2"></i>
                    </a>
                    <a href="#about" class="btn btn-outline-secondary homebanner-btn-secondary">
                        <i class="fa fa-user me-2"></i>
                        {{#str}}homebanner_aboutme, theme_holland{{/str}}
                    </a>
                </div>
            </div>

            <div class="homebanner-image-wrapper">
                <div class="homebanner-image-glow"></div>
                <div class="homebanner-image-container">
                    <div class="homebanner-image-bg"></div>
                    <div class="homebanner-image-frame">
                        <span class="homebanner-image">
                            {{#pix}}Illustratie_BasBrands, theme_holland{{/pix}}
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
