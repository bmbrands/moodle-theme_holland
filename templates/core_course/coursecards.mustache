{{!
    @template core_course/coursecards

    Holland theme override: renders course cards using the shared card partial.

    Example context (json):
    {
        "courses": [
            {
                "viewurl": "https://example.com/course/view.php?id=5",
                "courseimage": "https://example.com/course1.jpg",
                "fullname": "Introduction to Moodle",
                "summary": "Learn the basics of Moodle.",
                "coursecategory": "Miscellaneous"
            }
        ]
    }
}}

<div class="row row-cols-1 row-cols-md-3 g-4" data-region="card-deck" role="list">
    {{#courses}}
        {{> theme_holland/theme/coursecard }}
    {{/courses}}
</div>
