{{!
    @template core_courseformat/local/content/addresourceoractivitybutton

    Displays a themed add resource or activity button.

    Example context (json):
    {
        "sectionnum": 0,
        "sectionid": 0,
        "modid": 1,
        "activityname": "Activity example",
        "sectionreturnnum": 0,
        "sectionreturnid": 0
    }
}}
<button class="section-modchooser section-modchooser-link btn holland-add-btn d-inline-flex align-items-center gap-1 px-3 py-2 icon-no-margin"
    data-action="open-chooser"
    data-sectionnum="{{sectionnum}}"
    data-section-id="{{sectionid}}"
    {{#sectionreturnnum}}data-sectionreturnnum="{{.}}"{{/sectionreturnnum}}
    {{#sectionreturnid}}data-sectionreturnid="{{.}}"{{/sectionreturnid}}
    {{#modid}}
        data-beforemod="{{modid}}"
        aria-label="{{#str}}insertresourceoractivitybefore, core, { "activityname": {{#quote}} {{activityname}} {{/quote}} } {{/str}}"
        tabindex="0"
        title="{{#str}}addresourceoractivity, core{{/str}}"
    {{/modid}}
>
    {{#pix}} t/add, core {{/pix}}
    <span class="holland-add-btn-text">{{#str}}addresourceoractivity, core{{/str}}</span>
</button>
