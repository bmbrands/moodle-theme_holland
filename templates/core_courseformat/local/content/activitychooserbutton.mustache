{{!
    @template core_courseformat/local/content/activitychooserbutton

    Displays action links for adding activities or resources.

    Example context (json):
    {
        "hasactionlinks": false,
        "sectionnum": 0,
        "sectionname": "Section example",
        "modid": 1,
        "activityname": "Activity example",
        "sectionreturnnum": 0,
        "sectionreturnid": 0
    }
}}

<div class="holland-add-content d-flex align-items-center gap-2 flex-wrap">
    {{> core_courseformat/local/content/addresourceoractivitybutton }}
    {{#hasactionlinks}}
        {{#actionlinks}}
            {{> core/action_link}}
        {{/actionlinks}}
    {{/hasactionlinks}}
</div>
